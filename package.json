{
  "name": "notion-threads-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Publish explicitly approved Notion content to Threads.",
  "type": "module",
  "engines": {
    "node": ">=24.1.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "notion:inspect": "tsx src/cli/inspect-notion.ts",
    "notion:posts": "tsx src/cli/list-notion-posts.ts",
    "notion:publish": "tsx src/cli/publish-notion.ts",
    "threads:inspect": "tsx src/cli/inspect-threads.ts",
    "threads:publish-test": "tsx src/cli/publish-threads-test.ts",
    "threads:status": "tsx src/cli/threads-status.ts",
    "threads:refresh": "tsx src/cli/refresh-threads-token.ts",
    "mongodb:inspect": "tsx src/cli/inspect-mongodb.ts",
    "publication:status": "tsx src/cli/publication-status.ts",
    "publication:run": "tsx src/cli/run-publication-job.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@notionhq/client": "^5.26.0",
    "fastify": "^5.11.2",
    "mongodb": "^7.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
