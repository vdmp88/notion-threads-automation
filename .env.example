# Application
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

# Safety: keep true until a real Threads publication is explicitly approved.
DRY_RUN=true

# Notion (required starting in Phase 2)
NOTION_ACCESS_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=

# Threads / Meta (required starting in Phase 3)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/auth/threads/callback
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# MongoDB (required starting in Phase 4)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=notion_threads_automation

