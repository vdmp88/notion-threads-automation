# Application
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

# Safety: keep true until a real Threads publication is explicitly approved.
DRY_RUN=true
# Only the recurring publication job uses this opt-in. ready means approved.
AUTO_PUBLISH_ENABLED=false

# Notion (required starting in Phase 2)
NOTION_ACCESS_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=

# Threads (user access token; required for threads:inspect)
THREADS_ACCESS_TOKEN=

# MongoDB (required starting in Phase 4)
MONGODB_URI=mongodb://127.0.0.1:27017
# Local database used by the Stage 4 connection and publication repository.
MONGODB_DATABASE=notion_threads_automation
