# Application
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

# Safety: keep true until a real X (Twitter) publication is explicitly approved.
DRY_RUN=true

# Notion (required starting in Phase 2)
NOTION_ACCESS_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=

# X (Twitter): Phase 3 authentication is not configured yet.
# Add X-specific variables only after selecting the user-context auth flow.
# Verify API access and cost with the user before paid requests.

# MongoDB (required starting in Phase 4)
MONGODB_URI=mongodb://127.0.0.1:27017
# Historical local database name retained; the publishing target is X (Twitter).
MONGODB_DATABASE=notion_threads_automation
